# Published OAuth credentials (local only — do not commit)

# Copy to .env.oauth and fill in values from Google Cloud → Credentials.
# Used by `npm run pack` to inject into the store ZIP only.
# The Picker's public IDs (web client, API key, project number) go in picker/config.js, not here.

JT_OAUTH_CLIENT_ID=
JT_OAUTH_CLIENT_SECRET=
